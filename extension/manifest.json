{
  "manifest_version": 3,
  "name": "Brave Browser Bridge",
  "version": "0.1.4",
  "description": "Explicit, local bridge for AI-assisted inspection of the selected Brave tab.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:9229/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Brave Browser Bridge" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:9229"
  }
}
